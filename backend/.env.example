# Copy this file to .env and fill in your own values.
#
# Local MongoDB:   mongodb://127.0.0.1:27017/reliefnet
# MongoDB Atlas:   paste your connection string and ADD a database name
#                  right after the host, before the "?" — Atlas's copied
#                  string usually ends in a bare "/", which makes Mongoose
#                  default to a database literally called "test".
#                  e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/reliefnet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/reliefnet

PORT=5000
